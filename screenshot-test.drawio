        <mxCell id="FUZDe11bdULRlOeQR0kp-6" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px; color: rgb(76, 0, 153);&quot;&gt;react-native-screenshot-test&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
